---
/* GitHub Pages serves dist/404.html for any address that does not exist. */
import Base from '../layouts/Base.astro';
const home = import.meta.env.BASE_URL;
---
<Base title="404 · Destination host unreachable · Renso Anthony L. Casalme" description="This page does not exist. Head back to Renso Anthony L. Casalme's IT portfolio." scripts={false}>
  <main class="nf">
    <div class="nf-term" role="presentation">
      <div class="nf-bar" aria-hidden="true"><span></span><span></span><span></span><b>renso@dlsl: ~</b></div>
      <pre class="nf-out" aria-hidden="true"><span class="nf-p">$</span> ping this-page
Pinging this-page with 32 bytes of data:
<span class="nf-bad">Reply from 192.168.1.1: Destination host unreachable.</span>

Packets: Sent = 1, Received = 0, Lost = 1 (100% loss)</pre>
    </div>
    <h1 class="nf-title">404 · Destination host unreachable</h1>
    <p class="nf-sub">The page you asked for isn't on this network. The route home still works.</p>
    <a class="nf-btn" href={home}><i class="fa-solid fa-house" aria-hidden="true"></i> Back to the portfolio</a>
  </main>
</Base>

<style>
  .nf { min-height:100vh; min-height:100svh; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:18px; padding:40px 20px; text-align:center; }
  .nf-term { width:min(560px, 100%); background:var(--navy); border:1px solid rgba(255,255,255,.08); border-radius:var(--r-lg); overflow:hidden; text-align:left; box-shadow:var(--sh-md); }
  .nf-bar { display:flex; align-items:center; gap:7px; padding:9px 14px; background:rgba(255,255,255,.04); border-bottom:1px solid rgba(255,255,255,.07); }
  .nf-bar span { width:9px; height:9px; border-radius:50%; background:rgba(255,255,255,.14); }
  .nf-bar span:first-child { background:var(--accent-fill); }
  .nf-bar b { margin-left:8px; font:400 .7rem var(--fm); color:rgba(255,255,255,.45); }
  .nf-out { margin:0; padding:16px 18px; font:400 .8rem/1.7 var(--fm); color:#d9cfd0; white-space:pre-wrap; }
  .nf-p { color:var(--accent-on-dark); }
  .nf-bad { color:#f07178; }
  .nf-title { font-family:var(--fd); font-weight:800; font-size:clamp(1.4rem,4vw,2.2rem); color:var(--txt); }
  .nf-sub { color:var(--muted); max-width:460px; }
  .nf-btn { display:inline-flex; align-items:center; gap:9px; padding:13px 26px; border-radius:var(--r); background:var(--accent-fill); color:#fff; font-weight:600; }
  .nf-btn:hover, .nf-btn:focus-visible { background:var(--wine); outline:none; }
</style>
