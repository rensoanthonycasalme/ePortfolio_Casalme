---
/* Page shell: <head>, fonts, icons and the global stylesheets.
   Fonts and Font Awesome are self-hosted from npm (no Google Fonts / CDN requests).
   The stylesheets are imported in cascade order; they were one <style> block before. */
import HeadScript from '../components/HeadScript.astro';
import '@fontsource/syne/400.css';
import '@fontsource/syne/600.css';
import '@fontsource/syne/700.css';
import '@fontsource/syne/800.css';
import '@fontsource-variable/dm-sans';
import '@fontsource/space-mono/400.css';
import '@fortawesome/fontawesome-free/css/all.min.css';
import '../styles/01-tokens.css';
import '../styles/02-base.css';
import '../styles/03-sections.css';
import '../styles/04-responsive.css';
import '../styles/05-features.css';
import '../styles/06-labs.css';
import '../styles/07-terminal.css';

interface Props {
  title: string;
  description: string;
  /** false on pages that are not the portfolio itself (404): no feature scripts */
  scripts?: boolean;
}
const { title, description, scripts = true } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');   // always ends in "/"
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(base + 'og.jpg', Astro.site).href;
---
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0,viewport-fit=cover"/>
<meta name="theme-color" content="#0c0a0b"/>
<meta name="referrer" content="strict-origin-when-cross-origin"/>
<HeadScript />
<meta name="description" content={description}/>
<title>{title}</title>
<link rel="canonical" href={canonical}/>
<link rel="icon" href={base + 'favicon.svg'} type="image/svg+xml"/>
<link rel="icon" href={base + 'favicon-32.png'} sizes="32x32" type="image/png"/>
<link rel="apple-touch-icon" href={base + 'apple-touch-icon.png'}/>
<!-- link previews (Messenger, Viber, LinkedIn, X, Discord…) -->
<meta property="og:type" content="profile"/>
<meta property="og:site_name" content="Renso Anthony L. Casalme"/>
<meta property="og:title" content={title}/>
<meta property="og:description" content={description}/>
<meta property="og:url" content={canonical}/>
<meta property="og:image" content={ogImage}/>
<meta property="og:image:width" content="1200"/>
<meta property="og:image:height" content="630"/>
<meta property="og:image:alt" content="Renso Anthony L. Casalme, BS Information Technology at De La Salle Lipa, Class of 2027: IT Support, Networking, Cybersecurity"/>
<meta property="profile:first_name" content="Renso Anthony"/>
<meta property="profile:last_name" content="Casalme"/>
<meta name="twitter:card" content="summary_large_image"/>
<meta name="twitter:title" content={title}/>
<meta name="twitter:description" content={description}/>
<meta name="twitter:image" content={ogImage}/>
<slot name="head"/>
</head>
<body>
<slot />
{scripts && (
  <script>
    /* every feature module, in load order (see src/scripts/main.js) */
    import '../scripts/main.js';
  </script>
)}
</body>
</html>
