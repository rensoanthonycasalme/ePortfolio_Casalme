<!-- ════════════ TERMINAL (Feature 50) ════════════ -->
<div id="terminal" class="term-overlay" hidden>
  <div class="term-backdrop" data-term-close></div>
  <div class="term-win" role="dialog" aria-modal="true" aria-labelledby="termTitle" aria-describedby="termDesc">
    <div class="term-bar">
      <span class="term-dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <h2 class="term-title" id="termTitle">renso@dlsl: ~</h2>
      <button type="button" class="term-close" data-term-close aria-label="Close terminal"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
    </div>
    <p class="term-sr" id="termDesc">A text terminal for exploring this portfolio. Type help and press Enter, or use the command buttons. Tab completes, the up and down arrows recall history, Escape closes.</p>
    <div class="term-out" id="termOut" role="log" aria-live="polite" aria-label="Terminal output" tabindex="0"></div>
    <div class="term-chips" id="termChips" role="group" aria-label="Quick commands"></div>
    <form class="term-form" id="termForm" autocomplete="off">
      <span class="term-ps-in" id="termPrompt" aria-hidden="true">renso@dlsl:~$</span>
      <input class="term-in" id="termIn" type="text" aria-label="Terminal command" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" enterkeyhint="go" maxlength="300">
      <span class="term-busy" aria-hidden="true">running · Ctrl+C</span>
    </form>
  </div>
</div>
