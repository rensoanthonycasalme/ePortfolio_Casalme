<!-- ══════════════════════ MODAL ════════════════════════ -->
<div class="modal-overlay" id="modalOverlay">
  <div class="modal-box" id="modalBox" role="dialog" aria-modal="true" aria-labelledby="mTitle">
    <button type="button" class="modal-close" id="modalClose" aria-label="Close certificate"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
    <button type="button" class="modal-nav-btn" id="modalPrev" aria-label="Previous certificate"><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></button>
    <button type="button" class="modal-nav-btn" id="modalNext" aria-label="Next certificate"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
    <img class="modal-img" id="mImg" alt="" width="1400" height="1050" decoding="async"/>
    <div class="modal-content">
      <div class="modal-type" id="mType"></div>
      <h3 class="modal-title" id="mTitle"></h3>
      <div class="modal-meta" id="mMeta"></div>
      <div class="modal-links" id="mLinks"></div>
      <div class="modal-st"><i class="fa-solid fa-file-lines" aria-hidden="true"></i> Description</div>
      <div class="modal-desc" id="mDesc"></div>
      <div class="modal-st"><i class="fa-solid fa-graduation-cap" aria-hidden="true"></i> What I Learned</div>
      <div class="modal-learned" id="mLearned"></div>
      <div class="modal-counter" id="modalCounter">1 / 6</div>
    </div>
  </div>
</div>
